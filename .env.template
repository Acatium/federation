# Federation Demo — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.template .env

# ──────────────────────────────────────────────────────────────────
# AWS (required for S3, Glue, Redshift, Lake Formation, Spectrum)
# ──────────────────────────────────────────────────────────────────
AWS_PROFILE=default
AWS_REGION=us-east-2
AWS_ACCOUNT_ID=
# AWS credentials (required by Trino Hive connector for S3 access)
# Not needed if using IAM roles on EC2 or AWS_PROFILE-based auth
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
GLUE_CATALOG_ID=
GLUE_DATABASE=federation_demo
S3_BUCKET=
# IAM role ARN that Redshift assumes for Spectrum/COPY (arn:aws:iam::ACCOUNT:role/NAME)
SPECTRUM_ROLE_ARN=

# ──────────────────────────────────────────────────────────────────
# Redshift Serverless
# ──────────────────────────────────────────────────────────────────
REDSHIFT_HOST=
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=dev
REDSHIFT_USER=admin
REDSHIFT_PASSWORD=
# JDBC URL for Trino's Redshift connector (e.g. jdbc:postgresql://host:5439/dev)
REDSHIFT_JDBC_URL=

# ──────────────────────────────────────────────────────────────────
# Databricks (Unity Catalog)
# ──────────────────────────────────────────────────────────────────
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# Generate a PAT: Settings > Developer > Access tokens
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=

# ──────────────────────────────────────────────────────────────────
# Snowflake
# ──────────────────────────────────────────────────────────────────
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=FEDERATION_DEMO
# Snowflake role (leave blank to use the Snowflake default for your user)
SNOWFLAKE_ROLE=

# ──────────────────────────────────────────────────────────────────
# Immuta (leave blank to use the mock server at localhost:8089)
# ──────────────────────────────────────────────────────────────────
IMMUTA_BASE_URL=
IMMUTA_API_KEY=
# Port for the local mock Immuta server (default: 8089)
IMMUTA_MOCK_PORT=8089

# ──────────────────────────────────────────────────────────────────
# Federation Stack (Docker Compose on EC2 or local)
# ──────────────────────────────────────────────────────────────────
GRAVITINO_HOST=
GRAVITINO_PORT=8090
RANGER_HOST=
RANGER_PORT=6080
# Set to "https" if Ranger is behind TLS termination
RANGER_SCHEME=http
# Set to "https" if Gravitino is behind TLS termination
GRAVITINO_SCHEME=http
RANGER_ADMIN_USER=admin
RANGER_ADMIN_PASSWORD=
# Default password assigned to auto-provisioned Ranger users
RANGER_USER_DEFAULT_PASSWORD=
# Ranger service name (default: dev_trino)
RANGER_SERVICE=dev_trino
TRINO_HOST=
TRINO_PORT=8080
# Trino user for governed queries (default: test_user)
TRINO_USER=test_user
# Trino catalog name for the Hive/Glue connector (default: hive)
# When using the Gravitino connector, this should match the Gravitino catalog name
TRINO_HIVE_CATALOG=hive

# ──────────────────────────────────────────────────────────────────
# Iceberg (cold tier — S3 Iceberg V2 via Glue Data Catalog)
# ──────────────────────────────────────────────────────────────────
# Iceberg catalog name as registered in Gravitino (default: iceberg_s3)
ICEBERG_CATALOG=iceberg_s3

# ──────────────────────────────────────────────────────────────────
# Spark (multi-engine via Gravitino)
# ──────────────────────────────────────────────────────────────────
# Directory containing Gravitino Spark + Iceberg connector JARs
# (populated by deploy/download-spark-connector.sh)
SPARK_JARS_DIR=

# ──────────────────────────────────────────────────────────────────
# Bedrock (model catalog)
# ──────────────────────────────────────────────────────────────────
# AWS Bedrock is accessed via standard AWS credentials (AWS_ACCESS_KEY_ID etc.)
# No additional credentials needed — uses IAM bedrock:InvokeModel permissions

# ──────────────────────────────────────────────────────────────────
# Sync configuration (policy extraction intervals and stale detection)
# ──────────────────────────────────────────────────────────────────
# Tier 2 (Immuta FGAC) sync interval in seconds (default: 900 = 15min)
SYNC_TIER2_INTERVAL=900
# Tier 1 (platform-native) sync interval in seconds (default: 3600 = 1hr)
SYNC_TIER1_INTERVAL=3600
# Default/reference sync interval in seconds (default: 86400 = 24hr)
SYNC_DEFAULT_INTERVAL=86400
# Grace period before flagging policies as stale (default: 7200 = 2hr)
SYNC_STALE_GRACE_PERIOD=7200

# ──────────────────────────────────────────────────────────────────
# Docker Compose backend databases (used by deploy/docker-compose.yml)
# ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
RANGER_DB_PASSWORD=

# ──────────────────────────────────────────────────────────────────
# Demo notebook credentials
# ──────────────────────────────────────────────────────────────────
# Password for the demo_analyst user created in safe-by-default.ipynb
DEMO_ANALYST_PASSWORD=
