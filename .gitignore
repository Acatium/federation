# Virtual environment
.venv/

# Environment files (contain secrets)
.env
.env.*
!.env.template

# Python bytecode
__pycache__/
*.pyc
*.pyo

# Test / build caches
.pytest_cache/
.mypy_cache/
*.egg-info/
dist/
build/

# Runtime outputs (generated by agents and benchmarks)
results/*.json
contracts/*.json
data/

# Generated reports
reports/

# Deploy state (instance-specific, contains IPs)
deploy/instance-id.txt
deploy/public-ip.txt
# Generated SQL with substituted passwords (never commit)
deploy/init-ranger-db.generated.sql
# Downloaded plugin JARs (fetched by download scripts)
deploy/trino-plugins/ranger/
deploy/trino-plugins/gravitino-trino-connector-*/
jars/
# Generated rules file (Ranger fallback)
deploy/trino-config/rules.json

# SSH keys
*.pem
*.key

# Claude Code
.claude/

# Bootstrap script (project scaffolding — not part of the deliverable)
bootstrap.sh

# Internal design specs (not part of the deliverable)
spec/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
